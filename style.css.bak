/* Behavior Hotel - Official Letter Generator Styles */
:root {
  --primary-color: #8B1E2D;
  --primary-hover: #A52A3A;
  --secondary-color: #111827;
  --bg-color: #f1f5f9;
  --card-bg: #ffffff;
  --border-color: #e2e8f0;
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-muted: #64748b;
  --border-radius: 12px;
  --border-radius-lg: 16px;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 14px;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  background-color: var(--bg-color);
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 100vh;
  padding-bottom: 60px;
}

/* Header */
.app-header {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border-bottom: 2px solid var(--border-color);
  box-shadow: var(--shadow);
  padding: 1rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-container {
  max-width: 1600px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.header-info h1 {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--secondary-color);
  margin-bottom: 0.25rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.header-info h1 i {
  color: var(--primary-color);
}

.header-info p {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.header-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 1rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 500;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
  white-space: nowrap;
}

.btn:hover {
  background-color: #f8fafc;
  border-color: #cbd5e1;
  box-shadow: var(--shadow);
}

.btn:active {
  transform: translateY(1px);
}

.btn:focus-visible {
  outline: 2px solid var(--primary-color);
  outline-offset: 2px;
}

.btn-primary {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
  color: white;
}

.btn-primary:hover {
  background-color: var(--primary-hover);
  border-color: var(--primary-hover);
}

.btn-secondary {
  background-color: white;
  color: var(--text-primary);
}

.btn-ghost {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

.btn-ghost:hover {
  background-color: #f1f5f9;
  border-color: var(--border-color);
  box-shadow: var(--shadow-sm);
}

.btn-danger {
  background-color: white;
  color: #dc2626;
  border-color: var(--border-color);
}

.btn-danger:hover {
  background-color: #fee2e2;
  border-color: #fecaca;
}

.btn-small {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.375rem 0.75rem;
  font-family: 'Inter', sans-serif;
  font-size: 0.8125rem;
  font-weight: 500;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
}

.btn-small:hover {
  background-color: #f8fafc;
}

.btn-small.btn-ghost {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

.btn-small.btn-ghost:hover {
  background-color: #f1f5f9;
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
}

.btn-icon:hover {
  background-color: #f8fafc;
  border-color: #cbd5e1;
}

/* Main Layout */
.app-main {
  max-width: 1600px;
  margin: 0 auto;
  padding: 1.5rem;
}

.main-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: start;
}

/* Panels */
.editor-panel,
.preview-panel {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
}

.panel-header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border-color);
  background: linear-gradient(to right, #fafafa, #ffffff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.panel-header h2 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--secondary-color);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.panel-header h2 i {
  color: var(--primary-color);
}

.doc-status {
  padding: 0.25rem 0.75rem;
  background-color: #e0f2fe;
  color: #0369a1;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

/* Editor Content */
.editor-content {
  padding: 1.25rem;
  overflow-y: auto;
  flex: 1;
  max-height: calc(100vh - 220px);
}

/* Custom Scrollbar */
.editor-content::-webkit-scrollbar,
.preview-container::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.editor-content::-webkit-scrollbar-track,
.preview-container::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 4px;
}

.editor-content::-webkit-scrollbar-thumb,
.preview-container::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

.editor-content::-webkit-scrollbar-thumb:hover,
.preview-container::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* Form Sections */
.form-section {
  margin-bottom: 1.75rem;
  padding-bottom: 1.75rem;
  border-bottom: 1px solid var(--border-color);
}

.form-section:last-of-type {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.form-section h3 {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--secondary-color);
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--primary-color);
  display: inline-block;
}

/* Form Grid */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.875rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  position: relative;
}

.form-group.full {
  grid-column: 1 / -1;
}

.form-group label {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--text-primary);
}

.required {
  color: #dc2626;
  font-weight: 600;
}

.checkbox-label {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  gap: 0.5rem;
  font-weight: 500;
  cursor: pointer;
}

.checkbox-label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: var(--primary-color);
}

/* Inputs */
input[type="text"],
input[type="date"],
select,
textarea {
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  color: var(--text-primary);
  transition: all 0.2s ease;
  width: 100%;
}

input[type="text"]:focus,
input[type="date"]:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(139, 30, 45, 0.1);
}

textarea {
  resize: vertical;
  min-height: 60px;
  font-family: 'Inter', sans-serif;
  line-height: 1.5;
}

/* Rich Text Editor */
.rich-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem;
  background-color: #f8fafc;
  border: 1px solid var(--border-color);
  border-bottom: none;
  border-radius: var(--border-radius) var(--border-radius) 0 0;
}

.toolbar-group {
  display: flex;
  gap: 0.25rem;
  align-items: center;
}

.toolbar-group button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 1px solid transparent;
  border-radius: var(--border-radius);
  background-color: transparent;
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 0.875rem;
}

.toolbar-group button:hover {
  background-color: white;
  border-color: var(--border-color);
  box-shadow: var(--shadow-sm);
}

.toolbar-group button:active {
  transform: translateY(1px);
}

.toolbar-group select {
  padding: 0.375rem 0.5rem;
  font-size: 0.8125rem;
  height: 32px;
  width: auto;
  min-width: 100px;
}

.toolbar-divider {
  width: 1px;
  height: 24px;
  background-color: var(--border-color);
  margin: 0 0.25rem;
}

.editor-wrapper {
  border: 1px solid var(--border-color);
  border-top: none;
  border-radius: 0 0 var(--border-radius) var(--border-radius);
  overflow: hidden;
}

#content-editor {
  min-height: 200px;
  max-height: 300px;
  padding: 0.875rem;
  background-color: white;
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  line-height: 1.8;
  overflow-y: auto;
  outline: none;
  white-space: pre-wrap;
  word-wrap: break-word;
}

#content-editor:empty:before {
  content: attr(placeholder);
  color: #94a3b8;
  pointer-events: none;
}

#content-editor:focus {
  box-shadow: inset 0 0 0 2px rgba(139, 30, 45, 0.1);
}

#content-editor::-webkit-scrollbar {
  width: 8px;
}

#content-editor::-webkit-scrollbar-track {
  background: #f1f5f9;
}

#content-editor::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

.error-msg {
  color: #dc2626;
  font-size: 0.75rem;
  margin-top: 0.25rem;
  min-height: 16px;
}

/* Content Stats */
.content-stats {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* Logo Controls */
.logo-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.help-text {
  color: var(--text-muted);
  font-size: 0.75rem;
}

/* Signature Blocks */
.signature-block {
  margin-bottom: 1.5rem;
  padding: 0.875rem;
  background-color: #f8fafc;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
}

.signature-block:last-of-type {
  margin-bottom: 0;
}

.signature-block h4 {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.625rem;
}

.signature-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  margin-bottom: 0.625rem;
}

.signature-preview {
  min-height: 80px;
  border: 2px dashed var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  overflow: hidden;
}

.signature-preview img {
  max-height: 70px;
  max-width: 200px;
  object-fit: contain;
  height: auto;
  width: auto;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

/* Preview Panel */
.preview-panel {
  position: sticky;
  top: 90px;
  max-height: calc(100vh - 110px);
}

.zoom-controls {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  flex-wrap: wrap;
}

.zoom-level {
  font-size: 0.75rem;
  color: var(--text-secondary);
  min-width: 50px;
  text-align: center;
  font-weight: 500;
}

.preview-container {
  padding: 1.25rem;
  overflow-y: auto;
  overflow-x: auto;
  flex: 1;
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  max-height: calc(100vh - 220px);
}

/* A4 Page */
.a4-page {
  width: 210mm;
  min-height: 297mm;
  background: white;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  margin: 0 auto;
  padding: 18mm 20mm;
  position: relative;
  font-family: Arial, Helvetica, sans-serif;
  color: #000000;
  line-height: 1.6;
  font-size: 11pt;
}

/* Document Header */
.document-header {
  text-align: center;
  margin-bottom: 10px;
}

.logo-container {
  margin-bottom: 10px;
  min-height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#logo-img {
  max-height: 70px;
  max-width: 200px;
  height: auto;
  width: auto;
  object-fit: contain;
}

.default-logo {
  padding: 8px 16px;
}

.logo-text {
  font-size: 22pt;
  font-weight: bold;
  color: var(--primary-color);
  letter-spacing: 2px;
  font-family: 'Arial Black', Arial, sans-serif;
}

.company-details {
  margin-bottom: 8px;
}

.company-name {
  font-size: 14pt;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.company-address,
.company-info {
  font-size: 9pt;
  color: #333333;
  margin-bottom: 2px;
  line-height: 1.4;
}

.header-divider {
  height: 2px;
  background: linear-gradient(to right, transparent, var(--primary-color), transparent);
  margin: 10px 0 15px 0;
  border-radius: 1px;
}

/* Document Meta */
.document-meta {
  margin-bottom: 15px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.meta-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-item {
  display: flex;
  gap: 6px;
  font-size: 10pt;
}

.meta-label {
  font-weight: bold;
  color: #000000;
}

.meta-value {
  color: #000000;
  min-height: 14px;
}

.confidential-badge {
  display: inline-block;
  background-color: #fee2e2;
  color: #991b1b;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 8pt;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-top: 4px;
}

/* Recipient Block */
.recipient-block {
  margin-bottom: 15px;
  margin-left: 2mm;
}

.recipient-name {
  font-weight: bold;
  font-size: 11pt;
  color: #000000;
  min-height: 16px;
  margin-bottom: 4px;
}

.recipient-address {
  font-size: 10pt;
  color: #000000;
  white-space: pre-wrap;
  line-height: 1.5;
  min-height: 16px;
  margin-bottom: 4px;
}

.recipient-details {
  font-size: 10pt;
  color: #000000;
  min-height: 16px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* Subject Block */
.subject-block {
  margin-bottom: 15px;
  margin-top: 15px;
}

.subject-label {
  font-weight: bold;
  font-size: 11pt;
  color: #000000;
  margin-bottom: 4px;
}

.subject-text {
  font-size: 11pt;
  color: #000000;
  font-weight: bold;
  min-height: 16px;
  line-height: 1.5;
  white-space: pre-wrap;
}

/* Document Content */
.document-content {
  margin-bottom: 25px;
  font-size: 10pt;
  color: #000000;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
  min-height: 200px;
}

.document-content h1,
.document-content h2,
.document-content h3 {
  margin: 12px 0 8px 0;
  font-weight: bold;
  line-height: 1.4;
}

.document-content h1 {
  font-size: 12pt;
}

.document-content h2 {
  font-size: 11pt;
}

.document-content h3 {
  font-size: 10.5pt;
}

.document-content p {
  margin: 8px 0;
}

.document-content ul,
.document-content ol {
  margin: 8px 0;
  padding-left: 20px;
}

.document-content li {
  margin: 4px 0;
  line-height: 1.7;
}

.document-content strong,
.document-content b {
  font-weight: bold;
}

.document-content em,
.document-content i {
  font-style: italic;
}

.document-content u {
  text-decoration: underline;
}

/* Signatures Section */
.signatures-section {
  margin-top: 40px;
  margin-bottom: 30px;
}

.signature-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.signature-block-prev {
  flex: 1;
  min-width: 120px;
  max-width: 180px;
  text-align: center;
}

.signature-image {
  min-height: 60px;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.signature-image img {
  max-height: 55px;
  max-width: 150px;
  height: auto;
  width: auto;
  object-fit: contain;
}

.signature-line {
  height: 1px;
  background-color: #000000;
  margin: 6px 0 8px 0;
  width: 100%;
}

.signer-name {
  font-size: 9.5pt;
  font-weight: bold;
  color: #000000;
  margin-bottom: 2px;
  min-height: 14px;
}

.signer-title {
  font-size: 8.5pt;
  color: #333333;
  font-style: italic;
  min-height: 12px;
}

/* Document Footer */
.document-footer {
  position: absolute;
  bottom: 15mm;
  left: 20mm;
  right: 20mm;
  text-align: center;
  padding-top: 10px;
}

.footer-content {
  font-size: 8pt;
  color: #64748b;
  margin-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.page-number {
  font-size: 8pt;
  color: #64748b;
  margin-top: 4px;
}

/* Mobile Action Bar */
.mobile-action-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 2px solid var(--border-color);
  padding: 0.625rem;
  gap: 0.5rem;
  z-index: 1000;
  box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, 0.1);
}

/* Modal */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

.modal.active {
  display: flex;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  background: white;
  border-radius: var(--border-radius-lg);
  width: 90%;
  max-width: 600px;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  animation: slideUp 0.2s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-header h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--secondary-color);
}

.btn-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: 1px solid transparent;
  border-radius: var(--border-radius);
  background-color: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 1rem;
}

.btn-close:hover {
  background-color: #f1f5f9;
  color: var(--text-primary);
}

.modal-body {
  padding: 1.25rem;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--border-color);
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
  background-color: #fafafa;
}

#signature-canvas {
  width: 100%;
  height: 200px;
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  touch-action: none;
  cursor: crosshair;
  display: block;
}

.canvas-controls {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.75rem;
  justify-content: center;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 300px;
  overflow-y: auto;
}

.draft-item {
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  background-color: white;
  cursor: pointer;
  transition: all 0.2s ease;
}

.draft-item:hover {
  background-color: #f8fafc;
  border-color: var(--primary-color);
  box-shadow: var(--shadow-sm);
}

.draft-item-title {
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
}

.draft-item-meta {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.no-drafts {
  text-align: center;
  color: var(--text-muted);
  padding: 2rem;
  font-size: 0.875rem;
}

/* Responsive Design */
@media (max-width: 1280px) {
  .main-container {
    grid-template-columns: 1fr;
  }
  
  .preview-panel {
    position: static;
    max-height: none;
  }
  
  .editor-panel {
    max-height: none;
  }
  
  .editor-content {
    max-height: 600px;
  }
  
  .preview-container {
    max-height: 700px;
  }
}

@media (max-width: 768px) {
  body {
    padding-bottom: 70px;
  }
  
  .app-header {
    padding: 0.875rem;
  }
  
  .header-container {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .header-actions {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  
  .header-actions::-webkit-scrollbar {
    height: 6px;
  }
  
  .header-actions::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }
  
  .app-main {
    padding: 0.875rem;
  }
  
  .main-container {
    gap: 0.875rem;
  }
  
  .editor-panel,
  .preview-panel {
    max-height: none;
  }
  
  .editor-content {
    max-height: 500px;
  }
  
  .form-grid {
    grid-template-columns: 1fr;
  }
  
  .rich-toolbar {
    gap: 0.25rem;
  }
  
  .toolbar-group button,
  .toolbar-group select {
    height: 30px;
    font-size: 0.8125rem;
  }
  
  .toolbar-group button {
    width: 30px;
  }
  
  .signature-row {
    flex-direction: column;
  }
  
  .signature-block-prev {
    max-width: 100%;
  }
  
  .a4-page {
    width: 100%;
    min-width: 0;
    padding: 12mm 10mm;
    font-size: 9.5pt;
  }
  
  .logo-text {
    font-size: 18pt;
  }
  
  .company-name {
    font-size: 12pt;
  }
  
  .company-address,
  .company-info {
    font-size: 8pt;
  }
  
  .mobile-action-bar {
    display: flex;
  }
  
  .mobile-action-bar .btn {
    flex: 1;
    justify-content: center;
  }
  
  /* Mobile preview toggle */
  body.show-preview .editor-panel {
    display: none;
  }
  
  body.show-editor .preview-panel {
    display: none;
  }
  
  .preview-panel,
  .editor-panel {
    display: flex;
  }
}

/* Print Styles */
@media print {
  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  
  body {
    background: white !important;
    padding: 0 !important;
  }
  
  .app-header,
  .app-main .editor-panel,
  .app-main .preview-panel > .panel-header,
  .app-main .preview-panel > .preview-container > .zoom-controls,
  .mobile-action-bar,
  .modal,
  button,
  .rich-toolbar {
    display: none !important;
  }
  
  .app-main {
    padding: 0 !important;
    max-width: 100% !important;
  }
  
  .main-container {
    display: block !important;
    gap: 0 !important;
  }
  
  .preview-panel {
    display: block !important;
    position: static !important;
    max-height: none !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    background: white !important;
  }
  
  .preview-container {
    padding: 0 !important;
    background: white !important;
    overflow: visible !important;
    max-height: none !important;
    display: block !important;
  }
  
  .a4-page {
    width: 210mm !important;
    min-height: 297mm !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 18mm 20mm !important;
    box-shadow: none !important;
    page-break-after: always !important;
    background: white !important;
  }
  
  .document-footer {
    position: absolute !important;
    bottom: 15mm !important;
    left: 20mm !important;
    right: 20mm !important;
  }
  
  @page {
    size: A4 portrait;
    margin: 0;
  }
}